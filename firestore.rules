rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // USERS COLLECTION
    // Documents are keyed by lowercase username.
    match /users/{username} {
      allow read: if true;

      // Allow creating an account with role 'student' only
      allow create: if request.resource.data.username == username
                    && isValidString(request.resource.data.username, 3, 30)
                    && isValidString(request.resource.data.displayName, 1, 50)
                    && request.resource.data.role == 'student'
                    && request.resource.data.passwordHash is string;

      // Block update and delete
      allow update: if false;
      allow delete: if false;
    }

    // TOURNAMENTS COLLECTION
    match /tournaments/{tournamentId} {
      allow read: if true;

      // Allow creating tournaments with proper structure
      allow create: if isValidString(request.resource.data.name, 1, 100)
                    && request.resource.data.createdBy is string;

      // Updates may not change createdBy. Retake updates must still work.
      allow update: if (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy);

      // Block delete
      allow delete: if false;
    }

    // RESULTS COLLECTION
    match /results/{resultId} {
      allow read: if true;

      // Require competitionId (not tournamentId) on create, so scores save again
      allow create: if request.resource.data.competitionId is string
                    && request.resource.data.studentId is string;

      // Allow update only for the mark-grant fields (quizDetails, correctAnswers, score, accuracy)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quizDetails', 'correctAnswers', 'score', 'accuracy']);

      // Block delete
      allow delete: if false;
    }
  }
}
