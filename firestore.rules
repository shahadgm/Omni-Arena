rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // USERS COLLECTION
    // Documents are keyed by lowercase username.
    match /users/{username} {
      // Anyone can query/read public user metadata or authenticate
      allow read: if true;

      // Allow creating an account with required fields
      allow create: if request.resource.data.username == username
                    && isValidString(request.resource.data.username, 3, 30)
                    && isValidString(request.resource.data.displayName, 1, 50)
                    && request.resource.data.role in ['student', 'admin']
                    && request.resource.data.passwordHash is string;

      // Allow updating existing account (e.g. password change, display name update)
      // Prevent changing role to admin arbitrarily
      allow update: if resource.data.username == username
                    && request.resource.data.username == username
                    && (request.resource.data.role == resource.data.role || resource.data.role == 'admin');

      // Prevent unauthorized deletion of user accounts
      allow delete: if false;
    }

    // TOURNAMENTS COLLECTION
    match /tournaments/{tournamentId} {
      // Tournaments are readable by candidates to participate
      allow read: if true;

      // Allow creating tournaments with proper structure
      allow create: if isValidString(request.resource.data.name, 1, 100)
                    && request.resource.data.createdBy is string;

      // Allow updating tournaments (e.g. updating tournament details or settings)
      allow update: if isValidString(request.resource.data.name, 1, 100);

      // Allow deleting tournaments
      allow delete: if true;
    }

    // RESULTS COLLECTION
    match /results/{resultId} {
      // Results are readable for leaderboards
      allow read: if true;

      // Candidates can submit their own tournament result
      allow create: if request.resource.data.tournamentId is string
                    && request.resource.data.studentId is string;

      // Updates allowed for manager mark adjustments or retake resets
      allow update: if true;

      // Allow deletion when a tournament is deleted or retake is granted
      allow delete: if true;
    }
  }
}
